+    private func sourceKind(for audioURL: URL) -> PreparedSessionAudioSourceKind {
+        let fileName = audioURL.lastPathComponent.lowercased()
+        if fileName.hasSuffix(".raw.caf") {
+            return .rawCAF
+        }
+        if fileName.hasSuffix(".raw.flac") {
+            return .rawFLAC
+        }
+        if fileName.hasSuffix(".m4a") {
+            return .durableM4A
+        }
+        return .other
+    }
+
+    private func downmixToMono(
+        channelData: UnsafePointer<UnsafeMutablePointer<Float>>,
+        frameCount: Int,
+        channelCount: Int
+    ) -> (samples: [Float], strategy: PreparedSessionAudioDownmixStrategy) {
+        guard channelCount > 1 else {
+            return (
+                Array(UnsafeBufferPointer(start: channelData[0], count: frameCount)),
+                .passthroughMono
+            )
+        }
+
+        let dominantIndex = dominantChannelIndex(channelData: channelData, frameCount: frameCount, channelCount: channelCount)
+        if shouldPreferDominantChannel(
+            dominantIndex: dominantIndex,
+            channelData: channelData,
+            frameCount: frameCount,
+            channelCount: channelCount
+        ) {
+            return (
+                Array(UnsafeBufferPointer(start: channelData[dominantIndex], count: frameCount)),
+                .dominantChannel
+            )
+        }
+
+        var monoSamples: [Float] = Array(repeating: 0, count: frameCount)
+        for frame in 0..<frameCount {
+            var sum: Float = 0
+            for channel in 0..<channelCount {
+                sum += channelData[channel][frame]
+            }
+            monoSamples[frame] = sum / Float(channelCount)
+        }
+
+        return (monoSamples, .average)
+    }
+
+    private func dominantChannelIndex(
+        channelData: UnsafePointer<UnsafeMutablePointer<Float>>,
+        frameCount: Int,
+        channelCount: Int
+    ) -> Int {
+        var dominantIndex = 0
+        var dominantRMS: Float = -1
+
+        for channel in 0..<channelCount {
+            let rms = rootMeanSquare(of: channelData[channel], frameCount: frameCount)
+            if rms > dominantRMS {
+                dominantRMS = rms
+                dominantIndex = channel
+            }
+        }
+
+        return dominantIndex
+    }
+
+    private func shouldPreferDominantChannel(
+        dominantIndex: Int,
+        channelData: UnsafePointer<UnsafeMutablePointer<Float>>,
+        frameCount: Int,
+        channelCount: Int
+    ) -> Bool {
+        let dominantRMS = rootMeanSquare(of: channelData[dominantIndex], frameCount: frameCount)
+        guard dominantRMS > 0 else {
+            return false
+        }
+
+        var strongestOtherRMS: Float = 0
+        for channel in 0..<channelCount where channel != dominantIndex {
+            let otherRMS = rootMeanSquare(of: channelData[channel], frameCount: frameCount)
+            strongestOtherRMS = max(strongestOtherRMS, otherRMS)
+
+            if correlation(
+                between: channelData[dominantIndex],
+                and: channelData[channel],
+                frameCount: frameCount
+            ) < -0.8 {
+                return true
+            }
+        }
+
+        return strongestOtherRMS == 0 || dominantRMS > (strongestOtherRMS * 1.5)
+    }
+
+    private func rootMeanSquare(
+        of channel: UnsafeMutablePointer<Float>,
+        frameCount: Int
+    ) -> Float {
+        guard frameCount > 0 else { return 0 }
+
+        var sum: Float = 0
+        for index in 0..<frameCount {
+            let value = channel[index]
+            sum += value * value
+        }
+        return sqrt(sum / Float(frameCount))
+    }
+
+    private func correlation(
+        between lhs: UnsafeMutablePointer<Float>,
+        and rhs: UnsafeMutablePointer<Float>,
+        frameCount: Int
+    ) -> Float {
+        guard frameCount > 0 else { return 0 }
+
+        var lhsMean: Float = 0
+        var rhsMean: Float = 0
+        for index in 0..<frameCount {
+            lhsMean += lhs[index]
+            rhsMean += rhs[index]
+        }
+        lhsMean /= Float(frameCount)
+        rhsMean /= Float(frameCount)
+
+        var numerator: Float = 0
+        var lhsVariance: Float = 0
+        var rhsVariance: Float = 0
+
+        for index in 0..<frameCount {
+            let lhsCentered = lhs[index] - lhsMean
+            let rhsCentered = rhs[index] - rhsMean
+            numerator += lhsCentered * rhsCentered
+            lhsVariance += lhsCentered * lhsCentered
+            rhsVariance += rhsCentered * rhsCentered
+        }
+
+        let denominator = sqrt(lhsVariance * rhsVariance)
+        guard denominator > 0 else { return 0 }
+        return numerator / denominator
+    }
+}
