<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Barkenson</string>
	<key>CFBundleDisplayName</key>
	<string>Barkenson</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Barkenson needs system audio access to record the other people in a meeting.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Barkenson uses macOS screen recording access to capture meeting audio. Screen video is not saved.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Barkenson needs microphone access to record your voice during a meeting.</string>
